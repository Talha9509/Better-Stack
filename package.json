{
  "name": "betterstack",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "start:frontend": "cd apps/frontend && bun run start",
    "start:backend": "cd apps/api && bun run start",
    "start:pusher": "cd apps/pusher && bun run start",
    "db:generate": "cd packages/store && npx prisma generate && cd ../.."
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.9.7",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
